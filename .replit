modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ALLOWED_ORIGINS = "https://laundry-master.vercel.app"
CONTACT_FROM = "Laundry Master Contact <contactus@laundry-master.com>"
CONTACT_SMTP_HOST = "mail.laundry-master.com"
CONTACT_SMTP_PORT = "465"
CONTACT_SMTP_SECURE = "true"
CONTACT_SMTP_USER = "contactus@laundry-master.com"
CONTACT_TO = "contactus@laundry-master.com"
SITE_URL = "https://laundry-master.com"
SMTP_FROM = "Laundry Master <donotreply@laundry-master.com>"
SMTP_HOST = "mail.laundry-master.com"
SMTP_PORT = "465"
SMTP_SECURE = "true"
SMTP_USER = "donotreply@laundry-master.com"
