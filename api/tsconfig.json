{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@workspace/db": ["../lib/db/src/index.ts"],
      "@workspace/db/*": ["../lib/db/src/*"]
    }
  },
  "include": ["index.ts", "../artifacts/api-server/src/**/*"]
}
